# Example .env file for wattnet REST API configuration

## API Server Settings
API_HOST=localhost
API_PORT=8000
API_DEBUG=True

## Storage Database Settings
STORAGE_DB_URL=http://localhost:8428
TIMESERIES_STEP_MINUTES=15

## GeoJSON File Paths
GEOJSON_PATH=./data/geojson

## ENTSOE API Settings 
ENTSOE_API_KEY=your_entsoe_api_key_here
ENTSOE_BASE_URL=https://web-api.tp.entsoe.eu/api

## Logging Settings
LOG_LEVEL=DEBUG
LOG_HANDLERS=["console", "file"]
LOG_FILE=/var/log/wattnet-api.log
